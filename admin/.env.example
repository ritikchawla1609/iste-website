# Standalone Admin Portal Environment Configuration

# Backend API URL (where the Next.js API / server is running)
BACKEND_API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Public website URL (for the "Public Website" button in the admin header)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Standalone Admin Portal Port
PORT=3001
